# Copy this file to .env.local and fill it in. .env.local stays out of git.

# Client. Vite bundles these into the browser build, so none of them is secret.

# The Supabase project URL. The client in src/lib/supabase.ts and the functions in api/ read it.
VITE_SUPABASE_URL=
# The Supabase anon key. The client and the functions in api/ read it. Row-level security limits what it can do.
VITE_SUPABASE_ANON_KEY=
# The owner's Supabase user id. src/context/AuthProvider.tsx reads it to decide isOwner.
VITE_OWNER_USER_ID=
# The guest password for the gate in src/App.tsx. It ships in the bundle. See ADR 0001.
VITE_GUEST_PASSWORD=

# Functions in api/. Set these in Vercel too.

# The owner's Supabase user id. api/_lib/authorizeOwner.ts checks it.
OWNER_USER_ID=
# The Cloudinary API key. api/ uses it to sign uploads and delete assets.
CLOUDINARY_API_KEY=
# The Cloudinary API secret. It signs requests in api/ and never reaches the browser.
CLOUDINARY_API_SECRET=
# The Cloudinary cloud name for the functions in api/.
CLOUDINARY_CLOUD_NAME=
# The Cloudinary cloud name the functions in api/ fall back to when CLOUDINARY_CLOUD_NAME is empty.
VITE_CLOUDINARY_CLOUD_NAME=

# Supabase CLI. Only for linking and pulling the schema locally. GitHub Actions has its own copies as repo secrets.

# The database password. supabase link and supabase db pull read it.
SUPABASE_DB_PASSWORD=
# The project ref, the id in the project's Supabase URL. supabase link --project-ref reads it.
SUPABASE_PROJECT_REF=
